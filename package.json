{
  "name": "stem-splitter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "description": "Stem splitter for students \u2014 Railway Node host with a deferred Cloudflare migration and swappable GPU separation",
  "scripts": {
    "start": "tsx server/index.ts",
    "dev:node": "tsx watch server/index.ts",
    "dev": "wrangler dev --remote",
    "dev:local": "wrangler dev --local --port 8787",
    "separator:local": "UV_CACHE_DIR=.uv-cache uv run --project local-separator python local-separator/service.py --port 8765",
    "separator:test": "UV_CACHE_DIR=.uv-cache uv run --project local-separator python -m unittest discover -s local-separator -p 'test_*.py'",
    "analysis:start": "tsx audio-analysis/server.ts",
    "typecheck:analysis": "tsc -p audio-analysis/tsconfig.json --noEmit",
    "typecheck:instrument-evaluation": "tsc -p tsconfig.instrument-evaluation.json --noEmit",
    "test:analysis-service": "node --import tsx --test audio-analysis/*.test.ts tests/autosplit-parity.test.mts",
    "test:instrument-discovery": "python3 -m unittest discover -s instrument-discovery -p 'test_*.py'",
    "test:yamnet-comparator": "python3 -m unittest discover -s yamnet-comparator -p 'test_*.py'",
    "smoke:audio-analysis:image": "./scripts/smoke-audio-analysis-image.sh",
    "smoke:instrument-discovery:image": "./scripts/smoke-instrument-discovery-image.sh",
    "smoke:yamnet-comparator:image": "node --experimental-strip-types scripts/smoke-yamnet-comparator-image.mts",
    "smoke:local": "./scripts/smoke-local-bs.sh",
    "deploy": "wrangler deploy",
    "test:e2e": "playwright test --config playwright.config.mjs",
    "test:e2e:auto": "playwright test --config playwright.server-auto.config.mjs",
    "test:e2e:isolation-shadow": "playwright test --config playwright.isolation-shadow.config.mjs",
    "test:e2e:real": "playwright test --config playwright.real-audio.config.mjs",
    "test:e2e:real:run": "./scripts/run-real-audio-e2e.sh",
    "test:e2e:crate": "playwright test --config playwright.archive-crate.config.mjs",
    "test:e2e:crate:run": "./scripts/run-archive-crate-e2e.sh",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "check:replicate": "node --experimental-strip-types scripts/check-replicate-pin.mjs",
    "check:isolation": "node --experimental-strip-types scripts/check-isolation-pin.mjs",
    "check:audio-pipeline": "tsc -p tsconfig.audio-pipeline.json --noEmit && node --experimental-strip-types scripts/check-audio-pipeline-promotion.mts",
    "check:audio-listening": "tsc -p tsconfig.audio-pipeline.json --noEmit && node --experimental-strip-types scripts/check-audio-pipeline-listening.mts",
    "check:instrument-evaluation": "node --experimental-strip-types scripts/check-instrument-evaluation.mts",
    "compare:instrument-candidates": "node --experimental-strip-types scripts/compare-instrument-candidates.mts",
    "prepare:instrument-review": "node --experimental-strip-types scripts/prepare-instrument-evaluation-review.mts",
    "finalize:instrument-review": "node --experimental-strip-types scripts/finalize-instrument-evaluation-review.mts",
    "prepare:nsynth-review": "node --experimental-strip-types scripts/prepare-nsynth-family-control-review.mts",
    "finalize:nsynth-review": "node --experimental-strip-types scripts/finalize-nsynth-family-control-review.mts",
    "prepare:tinysol-review": "node --experimental-strip-types scripts/prepare-tinysol-exact-control-review.mts",
    "finalize:tinysol-review": "node --experimental-strip-types scripts/finalize-tinysol-exact-control-review.mts",
    "prepare:yamnet-candidate": "node --experimental-strip-types scripts/prepare-yamnet-candidate-source.mts",
    "capture:yamnet-candidate": "node --experimental-strip-types scripts/capture-yamnet-instrument-candidate.mts",
    "export:audio-listening": "tsc -p tsconfig.audio-pipeline.json --noEmit && node --experimental-strip-types scripts/export-audio-pipeline-listening-bundle.mts",
    "check:youtube": "node scripts/check-youtube-pin.mjs",
    "baseline:railway": "node scripts/capture-railway-baseline.mjs",
    "eval:stems": "node scripts/eval-stems.mjs",
    "eval:auto": "node --import tsx scripts/eval-autosplit.mts",
    "eval:auto:browser": "node --import tsx scripts/eval-autosplit-browser.mts",
    "eval:instruments": "node --import tsx scripts/eval-instrument-discovery.mts",
    "eval:instruments:image": "./scripts/run-instrument-discovery-eval.sh",
    "eval:instrument-scores:image": "./scripts/run-instrument-discovery-score-audit.sh",
    "eval:yamnet": "node --import tsx scripts/eval-yamnet-comparator.mts",
    "eval:yamnet:image": "./scripts/run-yamnet-comparator-eval.sh",
    "eval:yamnet:controls": "node --import tsx scripts/eval-yamnet-controls.mts",
    "hydrate:instrument-controls": "node --experimental-strip-types scripts/hydrate-instrument-controls.mts",
    "hydrate:nsynth-controls": "node --experimental-strip-types scripts/hydrate-nsynth-family-controls.mts",
    "hydrate:tinysol-controls": "node --experimental-strip-types scripts/hydrate-tinysol-exact-controls.mts",
    "hydrate:vcsl-controls": "node --experimental-strip-types scripts/hydrate-vcsl-exact-controls.mts",
    "eval:selftest": "./scripts/selftest-eval-stems.sh",
    "test:corpus": "node scripts/run-audio-corpus.mjs",
    "probe:replicate": "node --experimental-strip-types scripts/probe-replicate-outputs.mjs",
    "test:worker": "node --experimental-strip-types --test tests/*.test.mts",
    "test:server": "tsx --test tests/server-d1.test.ts tests/server-config.test.ts tests/isolation-terminal.test.ts",
    "test": "bun run typecheck && bun run typecheck:server && bun run test:worker && bun run test:server && bun run separator:test && bun run test:instrument-discovery && bun run test:yamnet-comparator",
    "test:phase0": "bun run typecheck && bun run typecheck:server && bun run typecheck:analysis && bun run typecheck:instrument-evaluation && bun run test:worker && bun run check:instrument-evaluation && bun run compare:instrument-candidates && bun run test:analysis-service && bun run test:server && bun run separator:test && bun run test:instrument-discovery && bun run test:yamnet-comparator && bun run test:e2e && bun run test:e2e:auto && bun run test:e2e:isolation-shadow",
    "db:migrate": "wrangler d1 execute stem-splitter --remote --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute stem-splitter --local --file=schema.sql",
    "db:migrate:2": "wrangler d1 execute stem-splitter --remote --file=migrations/0002-features.sql",
    "db:migrate:2:local": "wrangler d1 execute stem-splitter --local --file=migrations/0002-features.sql",
    "db:migrate:3": "wrangler d1 execute stem-splitter --remote --file=migrations/0003-assistant.sql",
    "db:migrate:3:local": "wrangler d1 execute stem-splitter --local --file=migrations/0003-assistant.sql",
    "db:migrate:4": "wrangler d1 execute stem-splitter --remote --file=migrations/0004-teachers.sql",
    "db:migrate:4:local": "wrangler d1 execute stem-splitter --local --file=migrations/0004-teachers.sql",
    "db:migrate:5": "wrangler d1 execute stem-splitter --remote --file=migrations/0005-assistant-prompt-history.sql",
    "db:migrate:5:local": "wrangler d1 execute stem-splitter --local --file=migrations/0005-assistant-prompt-history.sql",
    "db:migrate:6": "wrangler d1 execute stem-splitter --remote --file=migrations/0006-audio-routing.sql",
    "db:migrate:6:local": "wrangler d1 execute stem-splitter --local --file=migrations/0006-audio-routing.sql",
    "db:migrate:7": "wrangler d1 execute stem-splitter --remote --file=migrations/0007-guide-prompt-cache.sql",
    "db:migrate:7:local": "wrangler d1 execute stem-splitter --local --file=migrations/0007-guide-prompt-cache.sql",
    "db:migrate:8": "wrangler d1 execute stem-splitter --remote --file=migrations/0008-instrument-isolations.sql",
    "db:migrate:8:local": "wrangler d1 execute stem-splitter --local --file=migrations/0008-instrument-isolations.sql",
    "db:migrate:9": "wrangler d1 execute stem-splitter --remote --file=migrations/0009-job-source-hash.sql",
    "db:migrate:9:local": "wrangler d1 execute stem-splitter --local --file=migrations/0009-job-source-hash.sql",
    "db:migrate:10": "wrangler d1 execute stem-splitter --remote --file=migrations/0010-isolation-rollout-stage.sql",
    "db:migrate:10:local": "wrangler d1 execute stem-splitter --local --file=migrations/0010-isolation-rollout-stage.sql",
    "db:migrate:11": "wrangler d1 execute stem-splitter --remote --file=migrations/0011-job-source-hash-immutable.sql",
    "db:migrate:11:local": "wrangler d1 execute stem-splitter --local --file=migrations/0011-job-source-hash-immutable.sql",
    "db:migrate:12": "wrangler d1 execute stem-splitter --remote --file=migrations/0012-guide-prompt-hash.sql",
    "db:migrate:12:local": "wrangler d1 execute stem-splitter --local --file=migrations/0012-guide-prompt-hash.sql",
    "db:migrate:13": "wrangler d1 execute stem-splitter --remote --file=migrations/0013-prompt-history-immutable.sql",
    "db:migrate:13:local": "wrangler d1 execute stem-splitter --local --file=migrations/0013-prompt-history-immutable.sql",
    "db:migrate:14": "wrangler d1 execute stem-splitter --remote --file=migrations/0014-instrument-discovery-feedback.sql",
    "db:migrate:14:local": "wrangler d1 execute stem-splitter --local --file=migrations/0014-instrument-discovery-feedback.sql",
    "db:migrate:15": "wrangler d1 execute stem-splitter --remote --file=migrations/0015-instrument-isolation-budget.sql",
    "db:migrate:15:local": "wrangler d1 execute stem-splitter --local --file=migrations/0015-instrument-isolation-budget.sql",
    "db:migrate:16": "wrangler d1 execute stem-splitter --remote --file=migrations/0016-instrument-isolation-output-ingestion.sql",
    "db:migrate:16:local": "wrangler d1 execute stem-splitter --local --file=migrations/0016-instrument-isolation-output-ingestion.sql"
  },
  "engines": {
    "node": "22.23.1"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "aws4fetch": "^1.0.20",
    "hono": "^4.12.34",
    "tsx": "^4.23.5",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "22.20.1",
    "msw": "^2.15.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.114.0"
  }
}
