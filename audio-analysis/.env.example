# Private audio-analysis Railway service. Never commit real values.
AUDIO_ANALYSIS_TOKEN=generate-at-least-32-random-characters
AUDIO_ANALYSIS_SOURCE_ORIGINS=https://your-stem-splitter.up.railway.app

# The image and readiness probe enforce this exact pin.
AUDIO_ANALYSIS_EXPECTED_FFMPEG_VERSION=8.0.3

# Safe defaults shown explicitly for capacity planning.
AUDIO_ANALYSIS_MAX_CONCURRENCY=1
AUDIO_ANALYSIS_MAX_SOURCE_BYTES=104857600
AUDIO_ANALYSIS_MAX_SOURCE_SECONDS=900
AUDIO_ANALYSIS_FETCH_TIMEOUT_MS=5000
AUDIO_ANALYSIS_DECODER_TIMEOUT_MS=8000

# Local tests only; never enable on Railway.
# AUDIO_ANALYSIS_ALLOW_HTTP=true
