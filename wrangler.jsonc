{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stem-splitter",
  "account_id": "452c33847cf5cb1e46f391fca32fd1b5",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",

  // Static frontend (public/) is served directly; unmatched paths (/api/*) hit the Worker.
  "assets": {
    "directory": "./public"
  },

  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "stem-splitter-audio"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stem-splitter",
      "database_id": "8a0e3d0a-973b-41a4-bf72-0c9fb8dfdeb3"
    }
  ],

  "vars": {
    // Must match r2_buckets.bucket_name — used to build presigned URLs.
    "R2_BUCKET_NAME": "stem-splitter-audio",
    // Your Cloudflare account ID — used for the R2 S3 endpoint.
    "CF_ACCOUNT_ID": "452c33847cf5cb1e46f391fca32fd1b5",
    // Public URL of the deployed Worker — Replicate posts webhooks here.
    "PUBLIC_BASE_URL": "https://stem-splitter.ailab-452.workers.dev",
    // Which separation backend to use: "replicate" (production),
    // "audio-separator" (self-hosted), or "modal" (stub).
    "SEPARATION_BACKEND": "replicate",
    "REPLICATE_YT_MODEL": "smorello87/yt-audio",
    // Cloudflare egress is usually bot-blocked by YouTube. Start with the
    // authenticated yt-dlp service, then fall back to the in-Worker client.
    "YOUTUBE_FETCH_ORDER": "replicate-first",
    // OpenRouter model slug for the Listening Guy; swap to any cheap
    // tool-calling model without code changes. Unset disables the assistant.
    "ASSISTANT_MODEL": "z-ai/glm-5.2",
    // Independent tool-capable models tried when the primary route fails.
    "ASSISTANT_FALLBACK_MODELS": "anthropic/claude-haiku-4.5,google/gemini-3-flash-preview"
  }

  // Secrets (set with `wrangler secret put <NAME>`):
  //   R2_ACCESS_KEY_ID       — R2 API token key id (for presigned URLs)
  //   R2_SECRET_ACCESS_KEY   — R2 API token secret
  //   REPLICATE_API_TOKEN    — replicate.com API token
  //   REPLICATE_MODEL_VERSION— version hash of ryan5453/demucs (see README)
  //   AUDIO_SEPARATOR_TOKEN  — bearer token for the self-hosted separator API
  //   WEBHOOK_SECRET         — random string; authenticates Replicate webhooks
  //   CLASS_CODE             — shared code students enter to use the app
  //   OPENROUTER_API_KEY     — openrouter.ai key for the Listening Guy
}
