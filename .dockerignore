# Keep host state out of the worker image: COPY . . runs after bun install, and a
# copied-in mac node_modules would merge over the freshly installed linux one.
node_modules
.wrangler
.dev.vars*
audio-analysis/.env*
.uv-cache
output
dist
test-results
tests/corpus/audio
local-separator/.venv
local-separator/.data
local-separator/.models
docs/acceptance
.git
.claude
.hermes
*.docx
