# Copy to /etc/stem-separator/separator.env on the GPU host:
#   sudo install -d -m 0750 -o root -g stemsep /etc/stem-separator
#   sudo install -m 0640 -o root -g stemsep separator.env.example /etc/stem-separator/separator.env
# then edit the values. Never commit the real file. Runbook: docs/legion-separator.md

# Shared with the app as AUDIO_SEPARATOR_TOKEN. Generate with: openssl rand -hex 32
AUDIO_SEPARATOR_TOKEN=replace-with-openssl-rand-hex-32
# The Cloudflare Tunnel hostname. Stem URLs handed to the app are built from it.
# The unit sets AUDIO_SEPARATOR_EXPOSED=1, so the service refuses to start
# unless this is an https:// hostname and the token above is strong.
AUDIO_SEPARATOR_PUBLIC_URL=https://separator.your-domain.example

AUDIO_SEPARATOR_DATA_DIR=/var/lib/stem-separator/jobs
AUDIO_SEPARATOR_MODEL_DIR=/var/lib/stem-separator/models

# Exit at startup unless a CUDA kernel runs, so a broken driver means fallback
# to Replicate rather than half-hour CPU splits.
AUDIO_SEPARATOR_REQUIRE_CUDA=1
# Queued plus running jobs before the service answers 503 and the app uses
# Replicate. One GPU runs one split at a time.
AUDIO_SEPARATOR_MAX_PENDING=4
# Finished job folders (stems) are deleted after this many hours. The source
# file is deleted as soon as its split finishes.
AUDIO_SEPARATOR_RETENTION_HOURS=24

LOG_LEVEL=INFO
