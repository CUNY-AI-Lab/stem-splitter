    "db:migrate:26": "wrangler d1 execute cail-stem-splitter-preview --remote --file=../migrations/0026-song-samples.sql",
    "db:migrate:26:local": "wrangler d1 execute cail-stem-splitter-preview --local --file=../migrations/0026-song-samples.sql",
