{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Deploy this Worker before any splitter release that binds LINK_IMPORT.
  "name": "cail-stem-import",
  "account_id": "452c33847cf5cb1e46f391fca32fd1b5",
  "main": "link-import-worker.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  // Reachable only through the splitter's service binding.
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": true, "logs": { "invocation_logs": true, "head_sampling_rate": 1 } },
  // Same bucket as the splitter: imports land under the operation's fenced uploads/ key.
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "cail-stem-splitter-preview-audio" }]
}
