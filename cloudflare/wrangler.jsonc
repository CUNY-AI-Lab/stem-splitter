{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cail-stem-splitter-preview",
  "account_id": "452c33847cf5cb1e46f391fca32fd1b5",
  "main": "worker.ts",
  "alias": { "hono": "hono-cloudflare", "hono/factory": "hono-cloudflare/factory" },
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "BROWSER" },
  "workers_dev": true,
  "preview_urls": false,
  "limits": { "cpu_ms": 300000 },
  "queues": {
    "producers": [{"binding":"ADAPTIVE_OUTPUT","queue":"cail-stem-splitter-adaptive-output"}],
    "consumers": [{"queue":"cail-stem-splitter-adaptive-output","max_batch_size":1,"max_batch_timeout":1,"max_retries":20,"max_concurrency":1,"dead_letter_queue":"cail-stem-splitter-adaptive-output-dlq"}]
  },
  "triggers": { "crons": ["* * * * *", "0 8 * * *"] },
  "assets": { "directory": "../public", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true, "logs": { "invocation_logs": false, "head_sampling_rate": 1 } },
  "d1_databases": [{ "binding": "DB", "database_name": "cail-stem-splitter-preview", "database_id": "ae01c5db-c19e-48c8-91bd-132876276f22" }],
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "cail-stem-splitter-preview-audio" }],
  "services": [
    {"binding": "BUG_REPORTS", "service": "cail-tools-admission", "entrypoint": "AdmissionBugReports", "props": {"app": "stem-splitter", "origins": ["https://cail-stem-splitter-preview.ailab-452.workers.dev", "https://stem-splitter.ailab-452.workers.dev"]}},
    { "binding": "GATEWAY", "service": "cail-model-api" },
    { "binding": "LINK_IMPORT", "service": "cail-stem-import" },
    { "binding": "ADMISSION_RESOLVER", "service": "cail-tools-admission", "entrypoint": "AdmissionResolver" },
    { "binding": "IDENTITY", "service": "cail-doorway", "entrypoint": "WorkerIdentity", "props": { "id": "stem-splitter", "worker": "stem-splitter", "workspace": false } },
    { "binding": "PREVIEW_IDENTITY", "service": "cail-doorway", "entrypoint": "WorkerIdentity", "props": { "id": "stem-splitter", "worker": "cail-stem-splitter-preview", "workspace": false } }
  ],
  "ratelimits": [{ "name": "REQUEST_LIMIT", "namespace_id": "350609", "simple": { "limit": 30, "period": 60 } }],
  "vars": {
    "GATEWAY_MODEL": "glm-5.2",
    "GATEWAY_FALLBACK_MODEL": "deepseek-v4-flash-0731",
    "AUTH_MODE": "cail",
    "CAIL_CLASSROOM_ENABLED": "true",
    "CAIL_COURSE_IDS": "msh-245-the-american-musical-experience-fall-2026-01,cail-teaching-tools-demo",
    "GUEST_ENABLED": "true",
    "INTAKE_PAUSED": "false",
    "SPLIT_STARTS_DISABLED": "false",
    "RUN_DELETION_ENABLED": "true",
    "URL_IMPORT_ENABLED": "true",
    "LINK_IMPORT_ENABLED": "true",
    "CAIL_BROWSER_ORIGIN": "https://tools.ailab.gc.cuny.edu",
    "PUBLIC_BASE_URL": "https://stem-splitter.ailab-452.workers.dev",
    "CANONICAL_BASE_URL": "https://stem-splitter.ailab-452.workers.dev",
    "GUEST_TURNSTILE_SITE_KEY": "0x4AAAAAAFT4Vghg5XfSQlKb",
    "ROUTED_AUDIO": "true",
    "CF_ACCOUNT_ID": "452c33847cf5cb1e46f391fca32fd1b5",
    "R2_BUCKET_NAME": "cail-stem-splitter-preview-audio",
    "SEPARATION_BACKEND": "replicate",
    "ADAPTIVE_FOUR_ENABLED": "true",
    "SERVER_AUTO_ENABLED": "false",
    "SERVER_AUTO_MODE": "off",
    "INSTRUMENT_DISCOVERY_ENABLED": "false",
    "QUERY_ISOLATION_ENABLED": "false",
    "QUERY_ISOLATION_MODE": "off",
    "REMIXER_ENABLED": "false",
    "RELEASE": "cloudflare-editable-titles-20261021"
  }
}
