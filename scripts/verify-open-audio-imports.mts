// Explicit opt-in public downloads; local synthetic accounts/storage only, no splitting.
import {mkdtempSync,readFileSync,writeFileSync} from 'node:fs';
import {tmpdir} from 'node:os';import {join} from 'node:path';import {createHash} from 'node:crypto';import {spawnSync} from 'node:child_process';
import {SqliteD1} from '../server/d1.ts';import {FsR2Bucket} from '../server/r2.ts';import {submitSplit,resumeOwnedSourceImport} from '../src/reliability/splits.ts';import {courseFixture} from '../cloudflare/course-fixture.ts';import type {Env} from '../src/env.ts';import type {AppPrincipal} from '../src/identity.ts';
if(process.env.STEM_REAL_OPEN_AUDIO!=='1')throw new Error('Set STEM_REAL_OPEN_AUDIO=1 for six public/local imports');
const directory=mkdtempSync(join(tmpdir(),'stem-open-audio-six-'));const db=new SqliteD1(join(directory,'db'));db.applySchema(readFileSync(new URL('../schema.sql',import.meta.url),'utf8'));const bucket=new FsR2Bucket(join(directory,'audio'));
const subject='cail-'+ 'f'.repeat(32);await db.prepare('INSERT INTO app_users(subject) VALUES(?)').bind(subject).run();
const env={DB:db,AUDIO:bucket,AUTH_MODE:'cail',SEPARATION_BACKEND:'replicate',ADMISSION_RESOLVER:{resolveCourseAccessV2:({subject,classId}:any)=>courseFixture(subject,classId)}} as unknown as Env;
const principal={subject,role:'member',quotaClass:'member',displayName:'Synthetic source-import fixture',course:null,courseId:null} as AppPrincipal;
const cases=[['commons','64734368','original','Exit the Premises'],['commons','64736120','original','Hitman'],['commons','64739672','original','Merry Go'],['ccmixter','5847','5176','Body banging Inst'],['ccmixter','5843','5172','Mystro Soul Instumental'],['ccmixter','5734','5060','After Winter Dreams']];
const original=globalThis.fetch;let trace:any[]=[];
globalThis.fetch=async(input,init)=>{const url=new URL(String(input));if(!['commons.wikimedia.org','upload.wikimedia.org','ccmixter.org'].includes(url.hostname)||url.protocol!=='https:'||(init?.method??'GET')!=='GET')throw new Error('Non-public-provider call prohibited');const at=Date.now();try{const r=await original(input,init);trace.push({url:url.href,status:r.status,mime:r.headers.get('content-type'),contentLength:r.headers.get('content-length'),elapsedMs:Date.now()-at,redirectMode:init?.redirect});return r;}catch(e){trace.push({url:url.href,error:String(e),elapsedMs:Date.now()-at});throw e;}};
const results:any[]=[];
for(const[provider,itemId,fileId,query]of cases){trace=[];const started=Date.now();let result:any={provider,itemId,fileId,query,startedAt:new Date().toISOString()};try{
 const reserved=await submitSplit(env,principal,{openAudio:{provider,itemId,fileId},model:'vocals_instrumental'},crypto.randomUUID());await resumeOwnedSourceImport(env,principal,reserved.operation);
 const operation=await db.prepare('SELECT phase,state,error_code FROM app_operations WHERE id=?').bind(reserved.operation.id).first<any>();const job=await db.prepare('SELECT source_key,source_type,source_hash FROM jobs WHERE id=?').bind(reserved.operation.job_id).first<any>();
 const credit=await db.prepare('SELECT attribution FROM job_attributions WHERE job_id=?').bind(reserved.operation.job_id).first<any>();result.operation=operation;result.provenance=credit?JSON.parse(credit.attribution):null;
 if(operation.phase==='split'&&operation.state==='queued'&&credit){const object=await bucket.get(job.source_key);if(!object)throw new Error('Stored audio missing');const bytes=Buffer.from(await new Response(object.body).arrayBuffer());const hash=createHash('sha256').update(bytes).digest('hex');if(hash!==job.source_hash||job.source_type!==provider||result.provenance.provider!==provider)throw new Error('Stored provenance/hash mismatch');const path=join(directory,provider+'-'+itemId+'.mp3');writeFileSync(path,bytes);const decode=spawnSync(process.env.FFMPEG_PATH??'/tmp/stem-review-media/ffmpeg',['-v','error','-i',path,'-f','null','-'],{encoding:'utf8',timeout:60000});result={...result,outcome:'imported',bytes:bytes.length,mime:object.httpMetadata?.contentType,sha256:hash,decode:{status:decode.status,error:decode.stderr.trim()}};}else result.outcome='failed';
 }catch(error){result.outcome='failed';result.error=String(error);}result.elapsedMs=Date.now()-started;result.requests=[...trace];results.push(result);writeFileSync(process.env.STEM_IMPORT_RECEIPT??'../open-audio-six-runs.json',JSON.stringify({directory,checkedAt:new Date().toISOString(),processing:'Not started: no provider credentials or model calls; stopped after application reservation/native import/persistence',results},null,2));console.log(`${provider}/${itemId}: ${result.outcome} ${result.bytes??0} bytes; ${result.elapsedMs}ms; ${result.operation?.error_code??result.error??''}`);}
if((await db.prepare('SELECT COUNT(*) AS n FROM operation_attempts').first<any>())!.n!==0)throw new Error('Unexpected model attempt');
globalThis.fetch=original;
