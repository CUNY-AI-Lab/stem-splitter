# Railway container for the whole app: the Cloudflare Worker running under
# `node_modules/.bin/wrangler dev --local` (workerd via miniflare) on the LOCAL_HOSTING path —
# simulated D1/R2 persisted on a Railway volume at /data. This is the
# self-hosted posture; production Cloudflare deploys stay `bun run deploy`.
# Bun owns dependency installation; Wrangler runs under Node in the final image.
FROM oven/bun:1.3.14-slim AS deps

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

FROM node:22.23.1-slim

# workerd validates TLS against the system trust store (unlike node, which
# bundles its own CAs) — without ca-certificates every outbound HTTPS fetch
# from the Worker fails with an opaque "internal error".
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV WRANGLER_SEND_METRICS=false \
    CI=true

RUN chmod +x scripts/railway-worker-entrypoint.sh

EXPOSE 8080
CMD ["./scripts/railway-worker-entrypoint.sh"]
